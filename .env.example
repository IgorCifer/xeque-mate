# Copy to .env and fill in. Never commit .env.

# Postgres connection. Matches docker-compose.yml (local dev only).
DATABASE_URL="postgresql://xequemate:xequemate@localhost:5432/xequemate"

# better-auth secret, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""

# Base URL of the app, used by the server (better-auth) and the browser client.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_AUTH_URL="http://localhost:3000"
